# 保证从仓库复现到 Linux 时脚本仍是 LF，避免 shebang 带 \r 无法执行
* text=auto
*.py        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.launch    text eol=lf
*.service   text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.jpg       binary
*.png       binary
*.npz       binary
