[Unit]
Description=Chassis+Gimbal serial control bridge
After=jiaoda-lidar.service
[Service]
Type=simple
User=sjytt
ExecStart=/home/sjytt/jiaoda/run_control.sh
ExecStop=/usr/bin/python3 /home/sjytt/jiaoda/safe_stop.py
TimeoutStopSec=6
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
