[Unit]
Description=NvSciIpc initialization
Documentation=
After=sysinit.target
Before=multi-user.target

[Service]
ExecStart=/bin/sh /etc/systemd/nv_nvsciipc_init.sh
Type=oneshot

[Install]
WantedBy=multi-user.target
